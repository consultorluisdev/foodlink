# Copie para .env (ou exporte no shell) antes de rodar a API.
# Nenhum segredo real deve ser commitado: use .env local ou variáveis do CI.

# String de conexão do PostgreSQL (tem precedência sobre appsettings)
FOODLINK_DB_CONNECTION=Host=localhost;Port=5433;Database=foodlink_db;Username=postgres;Password=postgres

# Chave de assinatura do JWT (mínimo 32 caracteres). Em produção gere uma nova.
FOODLINK_JWT_KEY=troque-poruma-chave-aleatoria-de-no-minimo-32-chars

# Origens liberadas no CORS, separadas por virgula.
# Inclua o dominio do tunel/producao do catalogo quando subir.
FOODLINK_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://catalogo.foodlink.com.br